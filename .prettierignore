# Ignore artifacts:
build
coverage
*.css

# Hugo source templates use {{- /* ... */ -}} action comments and {{ }}
# expressions that prettier's HTML parser misinterprets — auto-formatting
# collapses comment blocks and breaks indentation around action blocks.
layouts/
archetypes/

# LaTeXML-generated documents carry a CSP whose hash covers the exact
# bytes of their <style> element; reformatting would break the hash.
public/docs/
